{
  "expo": {
    "name": "OtpVault",
    "slug": "OtpVault",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "otpvault",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.otpvault.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used to scan QR codes for adding OTP accounts.",
        "NSFaceIDUsageDescription": "Face ID is used to securely unlock the vault."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "package": "com.otpvault.mobile",
      "permissions": ["CAMERA", "USE_BIOMETRIC"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Camera is used to scan QR codes for adding OTP accounts."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Face ID is used to securely unlock the vault."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f172a",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "8954b2a0-8a25-4e21-a8e6-c2a75b5a6382"
      }
    }
  }
}
